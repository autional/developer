---
import DevLayout from '../layouts/DevLayout.astro';
import { t } from '../i18n';
import { brotherUrl } from '../lib/site-env';

const providers = (['auth0', 'clerk', 'firebase', 'keycloak'] as const).map((id) => ({
  id,
  title: t(`migration.providers.${id}.title`),
  time: t(`migration.providers.${id}.time`),
  steps: t(`migration.providers.${id}.steps`, { returnObjects: true }) as string[],
}));
---
<DevLayout title={t('migration.meta.title')} description={t('migration.meta.description')}>
  <section class="text-center">
    <span class="brand-kicker" data-i18n="migration.kicker">{t('migration.kicker')}</span>
    <h1 class="mt-6 text-5xl font-extrabold tracking-[var(--letter-spacing-display-xl)] text-primary-900 sm:text-6xl" data-i18n="migration.title">{t('migration.title')}</h1>
    <p class="page-lead mx-auto mt-6" data-i18n="migration.lead">
      {t('migration.lead')}
    </p>
  </section>

  <section class="mt-12 space-y-6">
    {providers.map((s) => (
      <div class="brand-card px-6 py-6">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <h2 class="text-2xl font-bold tracking-[var(--letter-spacing-heading-lg)] text-primary-900" data-i18n={`migration.providers.${s.id}.title`}>{s.title}</h2>
          <span class="inline-flex rounded-full bg-primary-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-primary-700"><span data-i18n="migration.estPrefix">{t('migration.estPrefix')}</span><span data-i18n={`migration.providers.${s.id}.time`}>{s.time}</span></span>
        </div>
        <ol class="mt-6 space-y-3">
          {s.steps.map((step, i) => (
            <li class="flex items-start gap-3 text-sm leading-7 text-neutral-600">
              <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary-700 text-xs font-bold text-white">{i + 1}</span>
              <span data-i18n={`migration.providers.${s.id}.steps.${i}`}>{step}</span>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>

  <section class="mt-16 brand-shell px-6 py-8 text-center sm:px-10">
    <h2 class="text-2xl font-bold tracking-[var(--letter-spacing-heading-lg)] text-primary-900 sm:text-3xl" data-i18n="migration.bottom.title">{t('migration.bottom.title')}</h2>
    <p class="mx-auto mt-3 max-w-2xl text-sm leading-7 text-neutral-600" data-i18n="migration.bottom.lead">
      {t('migration.bottom.lead')}
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/quickstart" class="brand-button-primary" data-i18n="index.cta.quickstart">{t('index.cta.quickstart')}</a>
      <a href={`${brotherUrl('docs')}/`} class="brand-button-secondary" data-i18n="migration.bottom.docs">{t('migration.bottom.docs')}</a>
      <a href="/api" class="brand-button-secondary" data-i18n="index.cta.api">{t('index.cta.api')}</a>
    </div>
  </section>
</DevLayout>
