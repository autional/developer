---
import DevLayout from '../layouts/DevLayout.astro';
import { t } from '../i18n';

// 链接文案键化；href 为站内结构路由（不随语言切换）。
const links = t('notFound.links', { returnObjects: true }) as { label: string; description: string }[];
const hrefs = ['/', '/quickstart', '/migration', '/api'];
---
<DevLayout title={t('notFound.meta.title')} description={t('notFound.meta.description')}>
  <section class="text-center">
    <span class="brand-kicker" data-i18n="notFound.kicker">{t('notFound.kicker')}</span>
    <h1 class="mt-6 text-5xl font-extrabold tracking-[var(--letter-spacing-display-xl)] text-primary-900 sm:text-6xl" data-i18n="notFound.title">{t('notFound.title')}</h1>
    <p class="page-lead mx-auto mt-6" data-i18n="notFound.lead">
      {t('notFound.lead')}
    </p>
  </section>

  <div class="mx-auto mt-12 grid max-w-3xl gap-4 md:grid-cols-2">
    {links.map((link, index) => (
      <a href={hrefs[index]} class="brand-card block px-6 py-5 no-underline">
        <div class="text-lg font-semibold text-primary-900" data-i18n={`notFound.links.${index}.label`}>{link.label}</div>
        <p class="mt-2 text-sm leading-7 text-neutral-600" data-i18n={`notFound.links.${index}.description`}>{link.description}</p>
      </a>
    ))}
  </div>
</DevLayout>
