---
import DevLayout from '../layouts/DevLayout.astro';
import { t } from '../i18n';
import { PACKAGES, API_CLIENTS, SERVICE_COUNT, TOTAL_PACKAGES } from '../data/site-data';

const highlights = [
  { labelKey: 'index.highlights.packages', value: String(TOTAL_PACKAGES) },
  { labelKey: 'index.highlights.apiClients', value: String(API_CLIENTS.length) },
  { labelKey: 'index.highlights.microservices', value: String(SERVICE_COUNT) },
];
---
<DevLayout title={t('index.meta.title')} description={t('index.meta.description')}>
  <section class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
    <div>
      <span class="brand-kicker" data-i18n="index.kicker">{t('index.kicker')}</span>
      {/* 此前是 leading-[var(--line-height-display-xl)] sm:leading-[var(--line-height-display-xl)] tracking-[var(--letter-spacing-display-xl)] —— 全部是站点自己发明的字距/行高。
    -0.06em 在 48px 的中文标题上等于每字收紧 2.88px（-6%），中文字身带边距，
    收紧到这个程度会明显挤在一起；这正是 U66 第③项说的「display 字距对 CJK 过紧」
    ——设计系统里早已修到 -0.02em，但**站点里还留着旧值**（上一轮我只查了 ui/ 仓，
    没查站点，所以漏了）。改为消费设计系统的排版令牌。 */}
<h1 class="mt-6 max-w-3xl text-5xl font-extrabold leading-[var(--line-height-display-xl)] sm:leading-[var(--line-height-display-xl)] tracking-[var(--letter-spacing-display-xl)] text-primary-900 sm:text-6xl" data-i18n="index.title">
        {t('index.title')}
      </h1>
      <p class="mt-6 page-lead max-w-2xl" data-i18n="index.lead">
        {t('index.lead')}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/quickstart" class="brand-button-primary" data-i18n="index.cta.quickstart">{t('index.cta.quickstart')}</a>
        <a href="/api" class="brand-button-secondary" data-i18n="index.cta.api">{t('index.cta.api')}</a>
      </div>
      <div class="mt-10 grid max-w-2xl gap-4 sm:grid-cols-3">
        {highlights.map((item) => (
          <div class="brand-card px-5 py-5">
            <div class="text-2xl font-extrabold tracking-[var(--letter-spacing-display-lg)] text-primary-800">{item.value}</div>
            <div class="mt-2 text-sm text-neutral-600" data-i18n={item.labelKey}>{t(item.labelKey)}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="developer-panel brand-grid relative overflow-hidden px-6 py-6">
      <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-sky-300/10 blur-3xl"></div>
      <div class="relative flex items-center justify-between text-xs uppercase tracking-[0.28em] text-[var(--color-text-muted)]">
        <span data-i18n="index.install.title">{t('index.install.title')}</span>
        <span><span>{TOTAL_PACKAGES}</span><span data-i18n="index.install.publishedSuffix">{t('index.install.publishedSuffix')}</span></span>
      </div>
      <pre class="developer-code mt-5">
<span class="text-syntax-comment">$</span> <span class="text-syntax-string">npm</span> <span class="text-syntax-plain">install</span> <span class="text-syntax-keyword">@autional/react</span>

<span class="text-syntax-keyword">import</span> <span class="text-syntax-plain">&#123; useAutional &#125;</span> <span class="text-syntax-keyword">from</span> <span class="text-syntax-function">'@autional/react'</span>;

<span class="text-syntax-keyword">function</span> <span class="text-syntax-string">App</span><span class="text-syntax-plain">()</span> <span class="text-syntax-plain">&#123;</span>
  <span class="text-syntax-keyword">const</span> <span class="text-syntax-plain">&#123; isAuthenticated, login &#125;</span> <span class="text-syntax-plain">=</span> <span class="text-syntax-keyword">useAutional</span><span class="text-syntax-plain">()</span>;
<span class="text-syntax-plain">&#125;</span>
      </pre>
      <div class="mt-6 flex flex-wrap gap-2">
        <span class="developer-chip" data-i18n="index.chips.sso">{t('index.chips.sso')}</span>
        <span class="developer-chip" data-i18n="index.chips.passkey">{t('index.chips.passkey')}</span>
        <span class="developer-chip" data-i18n="index.chips.rbac">{t('index.chips.rbac')}</span>
        <span class="developer-chip" data-i18n="index.chips.tenantIsolation">{t('index.chips.tenantIsolation')}</span>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="flex items-end justify-between gap-4">
      <div>
        <span class="brand-kicker" data-i18n="index.packages.kicker">{t('index.packages.kicker')}</span>
        <h2 class="mt-4 page-heading"><span data-i18n="index.packages.titleA">{t('index.packages.titleA')}</span><span>{TOTAL_PACKAGES}</span><span data-i18n="index.packages.titleB">{t('index.packages.titleB')}</span></h2>
      </div>
      <a href="/migration" class="hidden text-sm font-semibold text-primary-700 md:inline-flex" data-i18n="index.packages.viewMigration">{t('index.packages.viewMigration')}</a>
    </div>
    <div class="mt-8 grid gap-4">
      {PACKAGES.map((p) => (
        <div class="brand-card flex flex-col gap-4 px-6 py-5 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <code class="text-sm font-semibold text-primary-700">{p.name}</code>
            <p class="mt-2 text-sm leading-7 text-neutral-600" data-i18n={p.descKey}>{t(p.descKey)}</p>
          </div>
          <code class="inline-flex max-w-full overflow-x-auto rounded-md bg-code px-4 py-3 text-xs leading-6 text-syntax-plain lg:max-w-[28rem]">{p.install}</code>
        </div>
      ))}
    </div>
  </section>

  <section class="page-section grid gap-10 lg:grid-cols-[0.78fr_1.22fr]">
    <div class="brand-card px-6 py-6">
      <span class="brand-kicker" data-i18n="index.usage.kicker">{t('index.usage.kicker')}</span>
      <h2 class="mt-4 page-heading" data-i18n="index.usage.title">{t('index.usage.title')}</h2>
      <p class="mt-4 text-sm leading-7 text-neutral-600" data-i18n="index.usage.body">
        {t('index.usage.body')}
      </p>
      <div class="mt-6 space-y-3 text-sm text-neutral-600">
        <div class="rounded-md border border-primary-100 bg-primary-50/80 px-4 py-3"><strong class="text-primary-800" data-i18n="index.usage.fastLabel">{t('index.usage.fastLabel')}</strong><span data-i18n="index.usage.fastBody">{t('index.usage.fastBody')}</span></div>
        <div class="rounded-md border border-sky-100 bg-sky-50/80 px-4 py-3"><strong class="text-primary-800" data-i18n="index.usage.deepLabel">{t('index.usage.deepLabel')}</strong><span data-i18n="index.usage.deepBody">{t('index.usage.deepBody')}</span></div>
        <div class="rounded-md border border-amber-100 bg-amber-50/80 px-4 py-3"><strong class="text-primary-800" data-i18n="index.usage.entLabel">{t('index.usage.entLabel')}</strong><span data-i18n="index.usage.entBody">{t('index.usage.entBody')}</span></div>
      </div>
    </div>

    <div class="brand-card px-6 py-6">
      <div class="flex items-center justify-between gap-4">
        <div>
          <span class="brand-kicker" data-i18n="index.clients.kicker">{t('index.clients.kicker')}</span>
          <h2 class="mt-4 page-heading" data-i18n="index.clients.title">{t('index.clients.title')}</h2>
        </div>
        <span class="hidden rounded-full bg-primary-50 px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-primary-700 md:inline-flex" data-i18n="index.clients.badge">{t('index.clients.badge')}</span>
      </div>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
        {API_CLIENTS.map((a) => (
          <div class="rounded-md border border-primary-100/80 bg-white px-4 py-4 shadow-soft">
            <code class="text-xs text-primary-700">@autional/{a}</code>
          </div>
        ))}
      </div>
      <p class="mt-4 text-xs leading-6 text-neutral-600"><span data-i18n="index.clients.leadA">{t('index.clients.leadA')}</span><span>{API_CLIENTS.length}</span><span data-i18n="index.clients.leadB">{t('index.clients.leadB')}</span><a href="/api" class="text-primary-700 underline" data-i18n="index.clients.leadLink">{t('index.clients.leadLink')}</a><span data-i18n="index.clients.leadC">{t('index.clients.leadC')}</span></p>
    </div>
  </section>

  <section class="mt-16 brand-shell px-6 py-10 text-center sm:px-10">
    <span class="brand-kicker" data-i18n="index.final.kicker">{t('index.final.kicker')}</span>
    <h2 class="mt-5 text-3xl font-bold tracking-[var(--letter-spacing-display-lg)] text-primary-900 sm:text-4xl" data-i18n="index.final.title">{t('index.final.title')}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-base leading-8 text-neutral-600" data-i18n="index.final.lead">
      {t('index.final.lead')}
    </p>
    <pre class="developer-code mx-auto mt-6 max-w-xl text-left"><span class="text-syntax-comment">$</span> <span class="text-syntax-string">npm</span> <span class="text-syntax-plain">install</span> <span class="text-syntax-keyword">@autional/react</span>
<span class="text-syntax-comment">$</span> <span class="text-syntax-string">npx</span> <span class="text-syntax-keyword">@autional/onboard</span></pre>
  </section>
</DevLayout>
