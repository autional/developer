---
import DevLayout from '../layouts/DevLayout.astro';

const endpoints = [
  ['网关文档', 'https://reference.autional.cn/', '在浏览器中浏览全部 REST 端点与数据模型，由网关聚合提供交互式文档。'],
  ['服务规范', 'https://reference.autional.cn/specs/identity-service.json', '27 个微服务各自发布 OpenAPI 规范 JSON，可下载用于客户端生成与契约检查；地址形如 /specs/<服务名>-service.json。'],
  ['SDK 源码', 'https://github.com/autional/sdk', 'SDK 源码位于 GitHub 上的 autional/sdk 仓库。'],
];
---
<DevLayout title="API 参考 — Autional 开发者" description="面向开发者的 Autional API 参考 — 汇聚 27 个微服务的 1,400+ REST 端点，提供交互式文档与按服务划分的 OpenAPI 规范。">
  <section class="text-center">
    <span class="brand-kicker">API 概览</span>
    <h1 class="mt-6 text-5xl font-extrabold tracking-[var(--letter-spacing-display-xl)] text-primary-900 sm:text-6xl">一个开发者入口，汇聚 1,400+ REST 端点。</h1>
    <p class="page-lead mx-auto mt-6">
      在浏览器中浏览交互式 API 文档，下载各服务的 OpenAPI 规范用于客户端生成与契约检查，或从 GitHub 获取 SDK 与前端项目源码。
    </p>
  </section>

  <section class="mt-12 grid gap-5 lg:grid-cols-3">
    {endpoints.map(([name, url, description]) => (
      <div class="brand-card px-6 py-6">
        <h2 class="text-xl font-semibold text-primary-900">{name}</h2>
        <p class="mt-3 text-sm leading-7 text-neutral-600">{description}</p>
        <pre class="developer-code mt-5"><a href={url} class="underline">{url}</a></pre>
      </div>
    ))}
  </section>

  <section class="mt-16 brand-shell px-6 py-8 sm:px-10">
    <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <span class="brand-kicker">推荐流程</span>
        <h2 class="mt-4 page-heading">先从网关开始探索，再逐个服务深入。</h2>
      </div>
      <div class="space-y-4 text-sm leading-7 text-neutral-600">
        <div class="rounded-md border border-primary-100 bg-white px-4 py-4">
          <strong class="text-primary-800">集成时：</strong>需要快速发现接口时，使用网关的交互式文档。
        </div>
        <div class="rounded-md border border-sky-100 bg-sky-50/80 px-4 py-4">
          <strong class="text-primary-800">调试时：</strong>需要精确路径或 schema 时，直接查看具体服务的 OpenAPI 规范。
        </div>
      </div>
    </div>
  </section>
</DevLayout>
