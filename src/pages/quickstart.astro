---
import DevLayout from '../layouts/DevLayout.astro';
import { t } from '../i18n';
import { brotherUrl, CDN_HOST } from '../lib/site-env';

// 命令块分段渲染：文案段键化（data-i18n，客户端可切换），区域派生 URL 段随构建根域定死（不随语言切换）。
type CmdSegment = { key?: string; text?: string };

const prerequisites = t('quickstart.prereq.items', { returnObjects: true }) as string[];
const outcomes = t('quickstart.outcomes.items', { returnObjects: true }) as string[];
const issues = t('quickstart.issues.rows', { returnObjects: true }) as { issue: string; resolution: string }[];

const steps: { titleKey: string; copyKey: string; command: CmdSegment[] }[] = [
  {
    titleKey: 'quickstart.steps.items.0.title',
    copyKey: 'quickstart.steps.items.0.copy',
    command: [
      { key: 'quickstart.steps.items.0.cmdA' },
      { text: `${brotherUrl('docs')}/deployment/` },
      { text: '\ndocker compose -f docker-compose.infra.yml -f docker-compose.monolith.yml up -d' },
    ],
  },
  {
    titleKey: 'quickstart.steps.items.1.title',
    copyKey: 'quickstart.steps.items.1.copy',
    command: [
      { key: 'quickstart.steps.items.1.cmdA' },
      { text: `${brotherUrl('www')}/ai/skill.md` },
      { key: 'quickstart.steps.items.1.cmdB' },
      { text: `${CDN_HOST}/ai/latest/SKILL.md` },
    ],
  },
  {
    titleKey: 'quickstart.steps.items.2.title',
    copyKey: 'quickstart.steps.items.2.copy',
    command: [
      { text: 'curl http://localhost:11080/health\n' },
      { key: 'quickstart.steps.items.2.cmdA' },
      { text: 'http://localhost:11080/docs/' },
      { key: 'quickstart.steps.items.2.cmdB' },
    ],
  },
];
---
<DevLayout title={t('quickstart.meta.title')} description={t('quickstart.meta.description')}>
  <section class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
    <div>
      <span class="brand-kicker" data-i18n="quickstart.kicker">{t('quickstart.kicker')}</span>
      <h1 class="mt-6 text-5xl font-extrabold leading-[var(--line-height-display-xl)] sm:leading-[var(--line-height-display-xl)] tracking-[var(--letter-spacing-display-xl)] text-primary-900 sm:text-6xl" data-i18n="quickstart.title">
        {t('quickstart.title')}
      </h1>
      <p class="mt-6 page-lead" data-i18n="quickstart.lead">
        {t('quickstart.lead')}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="brand-button-primary" data-i18n="quickstart.cta.sdk">{t('quickstart.cta.sdk')}</a>
        <a href="/migration" class="brand-button-secondary" data-i18n="quickstart.cta.migration">{t('quickstart.cta.migration')}</a>
      </div>
    </div>

    <div class="brand-card px-6 py-6">
      <span class="brand-kicker" data-i18n="quickstart.prereq.kicker">{t('quickstart.prereq.kicker')}</span>
      <ul class="mt-6 space-y-3">
        {prerequisites.map((item, index) => (
          <li class="flex gap-3 text-sm leading-7 text-neutral-600">
            <span class="mt-2 h-2.5 w-2.5 rounded-full bg-sky-400"></span>
            <span data-i18n={`quickstart.prereq.items.${index}`}>{item}</span>
          </li>
        ))}
      </ul>
      <div class="mt-6 rounded-md border border-amber-100 bg-amber-50/80 px-4 py-4 text-sm leading-7 text-neutral-700" data-i18n="quickstart.prereq.note">
        {t('quickstart.prereq.note')}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div>
      <span class="brand-kicker" data-i18n="quickstart.steps.kicker">{t('quickstart.steps.kicker')}</span>
      <h2 class="mt-4 page-heading" data-i18n="quickstart.steps.title">{t('quickstart.steps.title')}</h2>
    </div>
    <div class="mt-8 grid grid-cols-1 gap-5 lg:grid-cols-3">
      {steps.map((step, index) => (
        <div class="brand-card px-6 py-6">
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-700 text-sm font-bold text-white">{index + 1}</span>
            <h3 class="text-xl font-semibold text-primary-900" data-i18n={step.titleKey}>{t(step.titleKey)}</h3>
          </div>
          <p class="mt-4 text-sm leading-7 text-neutral-600" data-i18n={step.copyKey}>{t(step.copyKey)}</p>
          <pre class="developer-code mt-5">{step.command.map((seg) => seg.key ? <span data-i18n={seg.key}>{t(seg.key)}</span> : <span>{seg.text}</span>)}</pre>
        </div>
      ))}
    </div>
  </section>

  <section class="page-section grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
    <div class="brand-card px-6 py-6">
      <span class="brand-kicker" data-i18n="quickstart.outcomes.kicker">{t('quickstart.outcomes.kicker')}</span>
      <div class="mt-6 space-y-4">
        {outcomes.map((item, index) => (
          <div class="rounded-md border border-primary-100 bg-primary-50/70 px-4 py-4 text-sm leading-7 text-neutral-700" data-i18n={`quickstart.outcomes.items.${index}`}>{item}</div>
        ))}
      </div>
    </div>

    <div class="brand-card px-6 py-6">
      <span class="brand-kicker" data-i18n="quickstart.issues.kicker">{t('quickstart.issues.kicker')}</span>
      <div class="mt-6 overflow-hidden rounded-lg border border-primary-100">
        <table class="w-full border-collapse text-left text-sm">
          <thead class="bg-primary-900 text-white">
            <tr>
              <th class="px-4 py-3 font-medium" data-i18n="quickstart.issues.head.issue">{t('quickstart.issues.head.issue')}</th>
              <th class="px-4 py-3 font-medium" data-i18n="quickstart.issues.head.resolution">{t('quickstart.issues.head.resolution')}</th>
            </tr>
          </thead>
          <tbody>
            {issues.map((row, index) => (
              <tr class="border-t border-primary-100 bg-white">
                <td class="px-4 py-4 font-medium text-primary-900" data-i18n={`quickstart.issues.rows.${index}.issue`}>{row.issue}</td>
                <td class="px-4 py-4 leading-7 text-neutral-600" data-i18n={`quickstart.issues.rows.${index}.resolution`}>{row.resolution}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</DevLayout>
