---
import '../styles/global.css';
import { t } from '../i18n';
import { LOCALE, SITE_URL, SITE_ROOT_DOMAIN, brotherUrl, cdnAsset, GITHUB_REPO_URL } from '../lib/site-env';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}
const {
  title = t('layout.meta.title'),
  description = t('layout.meta.description'),
  keywords,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pathname = Astro.url.pathname;
const ogImage = new URL('/og-default.png', Astro.site).href;
const navigation = [
  { href: '/', labelKey: 'nav.sdk' },
  { href: '/quickstart', labelKey: 'nav.quickstart' },
  { href: '/migration', labelKey: 'nav.migration' },
  { href: '/api', labelKey: 'nav.api' },
];
// 兄弟站链接随本区根域派生（cn → *.autional.cn；com → *.autional.com）。
const chromeLinks = [
  { href: brotherUrl('docs'), labelKey: 'layout.chrome.docs' },
  { href: brotherUrl('reference'), labelKey: 'layout.chrome.apiReference' },
  { href: brotherUrl('wiki'), labelKey: 'layout.chrome.wiki' },
  { href: GITHUB_REPO_URL, labelKey: 'layout.chrome.github' },
];
// 切换按钮展示目标语言（本区默认 zh → EN；en → 中文）；初始态与服务端一致，客户端脚本按当前语言重算。
const targetLang = LOCALE === 'zh-CN' ? 'en' : 'zh';
const targetLangLabel = t(targetLang === 'en' ? 'lang.switchToEn' : 'lang.switchToZh');
const chromeLinkClass = 'text-xs font-medium text-primary-500 hover:text-primary-700 transition';
---
<!DOCTYPE html>
<html lang={LOCALE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <link rel="stylesheet" href={cdnAsset('tokens.css')} />
    <link rel="stylesheet" href={cdnAsset('profiles/developer.css')} />
    <link rel="icon" href={cdnAsset('icons/favicon.ico')} sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href={cdnAsset('icons/favicon-32x32.png')}>
    <link rel="icon" type="image/png" sizes="16x16" href={cdnAsset('icons/favicon-16x16.png')}>
    <link rel="icon" type="image/svg+xml" href={cdnAsset('icons/favicon.svg')}>
    <link rel="apple-touch-icon" sizes="180x180" href={cdnAsset('icons/apple-touch-icon.png')}>
    <link rel="manifest" href={cdnAsset('icons/site.webmanifest')}>

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#003153">
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('layout.meta.title')} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@autional" />
    <meta name="twitter:creator" content="@autional" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: t('layout.meta.title'),
      url: SITE_URL,
      description: t('layout.jsonLdDescription'),
      publisher: { '@type': 'Organization', name: 'Autional', url: brotherUrl('www') },
    })} />
  </head>
  <body class="min-h-screen text-neutral-900">
    <div class="relative overflow-hidden">
      <div class="absolute inset-x-0 top-0 -z-10 h-[34rem] bg-gradient-to-b from-sky-100/65 via-white/0 to-transparent"></div>
      <header class="sticky top-0 z-50 border-b border-white/60 bg-white/80 backdrop-blur-xl">
        <div class="mx-auto flex h-[var(--layout-header-height)] max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
          <a href="/" class="flex items-center gap-4">
            <img src="/logo-mark.svg" alt={t('layout.logoAlt')} data-i18n-alt="layout.logoAlt" class="h-10 w-10 object-contain" />
            <div>
              <div class="text-lg font-extrabold tracking-[var(--letter-spacing-display-lg)] text-primary-800">Autional</div>
              <div class="text-xs font-medium uppercase tracking-[0.28em] text-[var(--color-text-muted)]" data-i18n="layout.brandSubtitle">{t('layout.brandSubtitle')}</div>
            </div>
          </a>
          <div class="hidden items-center gap-5 md:flex">
            <nav class="flex items-center gap-5">
              {navigation.map((item) => (
                <a href={item.href} class="developer-nav-link" data-active={pathname === item.href ? 'true' : 'false'} data-i18n={item.labelKey}>{t(item.labelKey)}</a>
              ))}
            </nav>
            <span class="w-px h-5 bg-neutral-200"></span>
            {chromeLinks.map((link) => (
              <a href={link.href} class={chromeLinkClass} data-i18n={link.labelKey}>{t(link.labelKey)}</a>
            ))}
            <a href={brotherUrl('www')} class="brand-button-secondary px-4 py-2 text-xs">{SITE_ROOT_DOMAIN}</a>
            <button type="button" data-lang-switch data-lang-target={targetLang} title={targetLangLabel} aria-label={targetLangLabel} class="brand-button-secondary px-4 py-2 text-xs">{targetLang === 'en' ? 'EN' : '中文'}</button>
          </div>
          <details class="relative md:hidden">
            <summary class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-xl border border-neutral-200 bg-white/80 text-neutral-700 transition hover:text-primary-700" aria-label={t('layout.aria.openMenu')} data-i18n-aria-label="layout.aria.openMenu">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <line x1="4" y1="7" x2="20" y2="7"></line>
                <line x1="4" y1="12" x2="20" y2="12"></line>
                <line x1="4" y1="17" x2="20" y2="17"></line>
              </svg>
            </summary>
            <div class="absolute right-0 top-[calc(100%+var(--space-2))] z-50 w-64 rounded-md border border-neutral-100 bg-white px-4 py-4 shadow-brand">
              <nav class="grid gap-1">
                {navigation.map((item) => (
                  <a href={item.href} class="developer-nav-link py-2" data-active={pathname === item.href ? 'true' : 'false'} data-i18n={item.labelKey}>{t(item.labelKey)}</a>
                ))}
              </nav>
              <div class="my-3 h-px bg-neutral-100"></div>
              <div class="grid gap-1">
                {chromeLinks.map((link) => (
                  <a href={link.href} class="py-2 text-xs font-medium text-primary-500 hover:text-primary-700 transition" data-i18n={link.labelKey}>{t(link.labelKey)}</a>
                ))}
                <button type="button" data-lang-switch data-lang-target={targetLang} title={targetLangLabel} aria-label={targetLangLabel} class="brand-button-secondary mt-1 justify-start px-4 py-2 text-xs">{targetLang === 'en' ? 'EN' : '中文'}</button>
                <a href={brotherUrl('www')} class="brand-button-secondary mt-1 px-4 py-2 text-xs">{SITE_ROOT_DOMAIN}</a>
              </div>
            </div>
          </details>
        </div>
      </header>

      <main class="mx-auto max-w-7xl px-4 pb-20 pt-10 sm:px-6 lg:px-8">
        <slot />
      </main>

      <footer class="border-t border-primary-100/80 bg-primary-900 text-white">
        <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-12 sm:px-6 lg:flex-row lg:items-start lg:justify-between lg:px-8">
          <div class="max-w-md">
            <div class="text-2xl font-extrabold tracking-[var(--letter-spacing-display-lg)]">Autional</div>
            <p class="mt-4 text-sm leading-7 text-sky-100/80" data-i18n="layout.footer.intro">{t('layout.footer.intro')}</p>
          </div>
          <div class="flex gap-12">
            <div class="grid gap-3 text-sm text-sky-100/80">
              <p class="text-xs font-semibold uppercase tracking-wider text-sky-200/70 mb-1" data-i18n="layout.footer.sitesTitle">{t('layout.footer.sitesTitle')}</p>
              <a href={brotherUrl('docs')} class="transition hover:text-white" data-i18n="layout.chrome.docs">{t('layout.chrome.docs')}</a>
              <a href={brotherUrl('reference')} class="transition hover:text-white" data-i18n="layout.chrome.apiReference">{t('layout.chrome.apiReference')}</a>
              <a href={brotherUrl('wiki')} class="transition hover:text-white" data-i18n="layout.chrome.wiki">{t('layout.chrome.wiki')}</a>
              <a href={brotherUrl('www')} class="transition hover:text-white" data-i18n="layout.footer.companySite">{t('layout.footer.companySite')}</a>
            </div>
            <div class="grid gap-3 text-sm text-sky-100/80">
              <p class="text-xs font-semibold uppercase tracking-wider text-sky-200/70 mb-1" data-i18n="layout.footer.contactTitle">{t('layout.footer.contactTitle')}</p>
              <a href="mailto:support@autional.net" class="transition hover:text-white">support@autional.net</a>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <script>
      // 语言交换（B2 单源机制）：切换按钮调 setLang() 后广播 LANG_EVENT，
      // 本脚本把带 data-i18n / data-i18n-<attr> 的节点就地重写为当前语言（全页可切换），并同步按钮目标语言。
      import { LANG_EVENT, currentLang, otherLang, restoreLang, setLang, translate } from '../i18n';

      const ATTRS = ['alt', 'aria-label', 'title'];

      const updateSwitch = () => {
        const lang = currentLang();
        const target = otherLang(lang);
        document.querySelectorAll('[data-lang-switch]').forEach((el) => {
          el.textContent = target === 'en' ? 'EN' : '中文';
          const label = translate(lang, target === 'en' ? 'lang.switchToEn' : 'lang.switchToZh');
          el.setAttribute('title', label);
          el.setAttribute('aria-label', label);
          el.setAttribute('data-lang-target', target);
        });
      };

      const applyChrome = () => {
        const lang = currentLang();
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (key) el.textContent = translate(lang, key);
        });
        for (const attr of ATTRS) {
          document.querySelectorAll(`[data-i18n-${attr}]`).forEach((el) => {
            const key = el.getAttribute(`data-i18n-${attr}`);
            if (key) el.setAttribute(attr, translate(lang, key));
          });
        }
        updateSwitch();
      };

      document.querySelectorAll('[data-lang-switch]').forEach((el) => {
        el.addEventListener('click', () => setLang(otherLang(currentLang())));
      });

      window.addEventListener(LANG_EVENT, applyChrome);
      // 采纳已存偏好（若有）后统一重写一次；restoreLang 内部走 setLang → 事件，此处兜底无偏好路径。
      restoreLang();
      applyChrome();
    </script>
  </body>
</html>
